{
  "version": 1,
  "defaults": {},
  "hosts": {
    "nas": {
      "opsWatch": {
        "intervalMinutes": 60,
        "standby": true
      },
      "giteaUrl": "http://192.168.0.10:3000",
      "gitUser": "mofua-suki",
      "allowedUsers": [
        "mofua-suki"
      ],
      "repositories": [
        {
          "name": "mofua-suki/sample-scraper",
          "displayName": "sample-scraper",
          "description": "NASでの画像収集。既存の取得範囲・停止条件を確認して開発する。",
          "testCommand": [
            "{node}",
            "--test",
            "--test-skip-pattern=^(fixed HTML extracts photo ownership|headed browser enables sandboxing)",
            "test/**/*.test.ts"
          ],
          "autoMerge": true,
          "autoDeploy": false
        },
        {
          "name": "mofua-suki/demo-image-culling",
          "displayName": "demo-image-culling",
          "description": "NAS（UGREEN DXP480T Plus、Core i5-1235U・メモリー31GiB・内蔵GPU Intel Iris Xe、UGOS Pro の Docker）で動かす収集画像の選別システム。sample-scraper が受け入れ用の置き場 /home/user/PhotosInbox に保存した画像を SigLIP2 で判定する。WD tagger はGPU/CPUに対応する。",
          "autoMerge": true,
          "autoDeploy": false,
          "testCommand": [
            "{node}",
            "--test",
            "test/*.test.ts"
          ]
        },
        {
          "name": "mofua-suki/issue-desk-intake",
          "displayName": "issue-desk-intake",
          "description": "NASのServerとClient",
          "testCommand": [
            "sh",
            "scripts/verify.sh"
          ],
          "autoMerge": true,
          "autoDeploy": false
        }
      ],
      "jobTimeoutSeconds": 3600,
      "testTimeoutSeconds": 300,
      "runtimeDir": "/state/runtime",
      "tokenFile": "/state/private/gitea-token",
      "workerTokenFile": "/state/private/worker-token",
      "intakeAccount": "issue-desk-intake",
      "webhook": {
        "port": 8790,
        "bind": "0.0.0.0",
        "tokenFile": "/state/private/webhook-token"
      },
      "codex": "/opt/agent-tools/bin/codex",
      "node": "/usr/local/bin/node",
      "pnpm": "/opt/agent-tools/bin/pnpm",
      "git": "/usr/bin/git",
      "model": "gpt-6.2-sol",
      "claudeModel": "opus",
      "codexEquivalents": {
        "fable": "gpt-6.2-astra",
        "opus": "gpt-6.2-sol",
        "sonnet": "gpt-6-luna",
        "haiku": "gpt-6-luna"
      },
      "implementation": {
        "tiers": {
          "light": {
            "model": "gpt-6-luna",
            "claudeModel": "sonnet",
            "reasoningEffort": "medium"
          },
          "standard": {
            "model": "gpt-6.2-sol",
            "claudeModel": "sonnet",
            "reasoningEffort": "medium"
          },
          "heavy": {
            "model": "gpt-6.2-sol",
            "claudeModel": "opus",
            "reasoningEffort": "high"
          }
        }
      },
      "review": {
        "provider": "claude",
        "claudeModel": "opus"
      },
      "usageWeights": {
        "default": {
          "input": 1,
          "cacheRead": 0.1,
          "cacheWrite": 1.25,
          "output": 5
        },
        "providers": {}
      },
      "priority": {
        "provider": "claude",
        "claudeModel": "haiku",
        "highRatio": {
          "min": 0.2,
          "max": 0.3
        }
      },
      "stallWatch": {
        "idleMinutes": 60,
        "claimMinutes": 30,
        "repeatedFailures": 3,
        "blockedRatio": 50,
        "blockedMin": 3
      },
      "antigravity": {
        "command": "/opt/agent-tools/bin/agy",
        "settingsFile": "/home/node/.gemini/antigravity-cli/settings.json",
        "model": "gemini-3.8-flash-high"
      },
      "environment": {
        "platform": "linux",
        "gcc": null,
        "cgo": null,
        "race": null,
        "docker": null,
        "realDevice": null,
        "liveMeasurement": null,
        "network": null
      }
    },
