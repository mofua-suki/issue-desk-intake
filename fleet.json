          "displayName": "alarm-checklist",
          "description": "iPhone向けFlutterアラーム管理アプリ",
          "testCommand": [
            "{node}",
            "--test",
            "test/ios-environment.test.mjs"
          ],
          "autoMerge": true,
          "autoDeploy": false
        },
        {
          "name": "mofua-suki/image-review-client",
          "displayName": "image-review-client",
          "description": "IPS・IGSの評価・選別画面をまとめる、iPhone/iPad向けのSPA（PWA、TypeScript）。IPS・IGSのAPIを使う。",
          "testCommand": [
            "{node}",
            "--test",
            "test/**/*.test.ts"
          ],
          "autoMerge": true,
          "autoDeploy": false
        },
        {
          "name": "games/game-laboratory",
          "displayName": "game-laboratory",
          "description": "ブラウザで遊ぶゲームの試作置き場（HTMLとJavaScript、ビルドなし）。games/<ゲーム名>/ ごとに1本のゲームを置き、スマホのブラウザで遊べる形にする。",
          "testCommand": [
            "{node}",
            "--test",
            "test/_*.test.mjs"
          ],
          "autoMerge": true,
          "autoDeploy": false
        }
      ],
