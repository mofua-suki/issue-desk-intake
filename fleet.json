          "testCommand": [
            "gradle",
            "--no-daemon",
            "test"
          ],
          "autoMerge": true,
          "autoDeploy": false
        },
        {
          "name": "mofua-suki/sample-expense-client",
          "nativeTestHost": "macbook-pro-test",
          "displayName": "sample-expense-client",
          "description": "精算アプリのクライアント（Flutter、Android と iOS（iPhone・iPad）。iOS はMacBook Proでシミュレーター向けビルドとシミュレーター上のテストを検証）。sample-expense-server のAPIを使い、グループの作成・精算の登録・全員の同意による精算の締めを操作する。",
          "testCommand": [
            "flutter",
            "test"
          ],
          "autoMerge": true,
          "autoDeploy": false
        },
        {
          "name": "mofua-suki/alarm-checklist",
