# Tailscale HTTPS registry（スキームを付けない）
REGISTRY=ugreen-nas.example.ts.net:5443
# fleet.jsonのpython=trueのPCは-python、それ以外は空
FLAVOR=
# 引き取る色のタグ。初回は発行した sha12。hostd が更新する
ISSUE_DESK_CLIENT_TAG=0123456789ab
# 色ごとのタグ（空なら ISSUE_DESK_CLIENT_TAG）。退く色の版も保持できる
ISSUE_DESK_CLIENT_BLUE_TAG=
ISSUE_DESK_CLIENT_GREEN_TAG=
# green は docker compose --profile green up -d で起動する。設定の用意は hostd が行う
TZ=Asia/Tokyo
