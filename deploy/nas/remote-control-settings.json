      "Bash(journalctl *--rot*)",
      "Bash(journalctl *--fl*)",
      "Bash(journalctl *--cursor-*)",
      "Bash(sudo *)",
      "Bash(su)",
      "Bash(su *)",
      "Bash(rm -rf *)",
      "Bash(rm* -r*)",
      "Bash(rm* -R*)",
      "Bash(rm* --r*)",
      "Bash(rm* -*fr*)",
      "Bash(rm* -*ir*)",
      "Bash(rm* -*Ir*)",
      "Bash(rm* -*vr*)",
      "Bash(rm* -*dr*)",
      "Bash(rm* -*fR*)",
      "Bash(rm* -*iR*)",
