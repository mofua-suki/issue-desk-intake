{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.issue-desk/node ~/.claude/hooks/chat-stop-hook.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(~/.issue-desk/desk)",
      "Bash(~/.issue-desk/desk *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git diff --name-status)",
      "Bash(git diff --check)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git diff --staged)",
      "Bash(git diff HEAD)",
      "Bash(git diff main...HEAD)",
      "Bash(git diff --stat main...HEAD)",
      "Bash(git diff origin/main...HEAD)",
      "Bash(git diff --stat origin/main...HEAD)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(node --test)",
      "Bash(node --test *)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(journalctl --user)",
      "Bash(journalctl --user *)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl --user list-units)",
      "Bash(systemctl --user list-units *)",
      "Bash(docker ps)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(sleep *)",
      "Edit(~/.issue-desk/requests/**)",
      "Write(~/.issue-desk/requests/**)"
    ],
    "deny": [
      "Read(~/.issue-desk/token)",
      "Edit(~/.issue-desk/token)",
      "Write(~/.issue-desk/token)",
      "Read(**/private/**)",
      "Edit(**/private/**)",
      "Write(**/private/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Edit(~/.issue-desk/remote-control/**)",
