      "Bash(docker compose down *)",
      "Bash(docker *compose* down)",
      "Bash(docker *compose* down *)",
      "Bash(docker-compose* down)",
      "Bash(docker-compose* down *)",
      "Bash(systemctl --user stop *)",
      "Bash(systemctl --user disable *)",
      "Bash(systemctl --user edit *)",
      "Bash(systemctl* stop *)",
      "Bash(systemctl* disable *)",
      "Bash(systemctl* edit *)",
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* -*vf*)",
      "Bash(git *push* -*qf*)",
      "Bash(git *push* -*uf*)",
      "Bash(git *push* -*nf*)",
      "Bash(git *push* -*df*)",
      "Bash(git *push* -*ff*)",
      "Bash(git *push* -*4f*)",
      "Bash(git *push* -*6f*)",
      "Bash(git *push* +*)",
      "Bash(git *push* --mirror*)",
      "Bash(git *push* --m*)",
      "Bash(git *push* --all*)",
      "Bash(git *push* --al*)",
      "Bash(git *push* --b*)",
      "Bash(git *push* main)",
      "Bash(git *push* main *)",
      "Bash(git *push*:main)",
      "Bash(git *push*:main *)",
