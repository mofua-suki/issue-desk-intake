      "Edit(~/rc/*/.claude/**)",
      "Write(~/rc/*/.claude/**)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Write(~/.claude/hooks/**)",
      "Bash(*.issue-desk/token*)",
      "Bash(*/private/*)",
      "Bash(*.ssh/*)",
      "Bash(*.issue-desk/remote-control*)",
      "Bash(*.config/systemd/user*)",
      "Bash(*.claude/settings.json*)",
      "Bash(*.claude/hooks*)",
      "Bash(git *--output*)",
      "Bash(git *--no-index*)",
      "Bash(node *--test-reporter-destination*)",
      "Bash(node *--import*)",
