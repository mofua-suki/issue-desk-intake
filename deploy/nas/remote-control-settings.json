      "Bash(rm* -*vR*)",
      "Bash(rm* -*dR*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker rm *)",
      "Bash(docker * run *)",
      "Bash(docker * exec *)",
      "Bash(docker * rm *)",
