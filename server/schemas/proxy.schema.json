{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "readFiles",
    "answers"
  ],
  "properties": {
    "readFiles": {
      "description": "追加で読む資料。通常ファイルの文字列は全文。オブジェクトはfull・outline・lines・keyword。repo-search（別プロジェクトのowner/repo:repo-searchを含む）はkeyword方式と空でない検索語を指定する。",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(?:.{0,10}|.*[^:]repo-search|.*[^r].{10}|.*[^e].{9}|.*[^p].{8}|.*[^o].{7}|.*[^-].{6}|.*[^s].{5}|.*[^e].{4}|.*[^a].{3}|.*[^r].{2}|.*[^c].{1}|.*[^h].{0})$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "mode",
              "start",
              "end",
              "keyword",
              "context"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(?:.{0,10}|.*[^:]repo-search|.*[^r].{10}|.*[^e].{9}|.*[^p].{8}|.*[^o].{7}|.*[^-].{6}|.*[^s].{5}|.*[^e].{4}|.*[^a].{3}|.*[^r].{2}|.*[^c].{1}|.*[^h].{0})$"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "full",
                  "outline",
                  "lines",
                  "keyword"
                ]
              },
              "start": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "keyword": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "context": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "mode",
              "start",
              "end",
              "keyword",
              "context"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:)?repo-search$"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "keyword"
                ]
              },
              "start": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "keyword": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\r\\n]+$"
              },
              "context": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        ]
      }
    },
    "answers": {
      "description": "questions の各質問（index は1から）への判断。1つの質問に1件。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "decision",
          "category",
          "answer",
          "evidence",
          "forwardReason"
        ],
        "properties": {
          "index": {
            "type": "integer"
          },
          "decision": {
            "description": "answer: 代理で答える。forward: 利用者に回す。",
            "type": "string",
            "enum": [
              "answer",
              "forward"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "fact",
              "issueState",
              "pastDecision",
              "convention",
              "policy",
              "priority",
              "money",
              "permission",
              "credential",
              "consent",
              "approval",
              "irreversible",
              "preference",
              "undetermined",
              "quality"
            ]
          },
          "answer": {
            "type": "string"
          },
          "evidence": {
            "description": "根拠。document（資料のパスと箇所）・decision（過去の決定のID）・reference（共通番号の解決結果）・recommendation（受付AIの推奨）。",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source",
                "location",
                "detail"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "document",
                    "decision",
                    "reference",
                    "recommendation"
                  ]
                },
                "source": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          },
          "forwardReason": {
            "type": "string"
          }
        }
      }
    }
  }
}
