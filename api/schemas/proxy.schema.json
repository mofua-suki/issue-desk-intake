{
  "type": "object",
  "additionalProperties": false,
  "required": ["readFiles", "answers"],
  "properties": {
    "readFiles": {
      "description": "追加で読む資料。文字列は全文、オブジェクトは部分読み取り（outline・lines・keyword）。file はGiteaのパス（別のプロジェクトは owner/repo:パス）。返したときの answers は使われない。",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "mode", "start", "end", "keyword", "context"],
            "properties": {
              "file": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": ["outline", "lines", "keyword"]
              },
              "start": {
                "type": ["integer", "null"]
              },
              "end": {
                "type": ["integer", "null"]
              },
              "keyword": {
                "type": ["string", "null"]
              },
              "context": {
                "type": ["integer", "null"]
              }
            }
          }
        ]
      }
    },
    "answers": {
      "description": "questions の各質問（index は1から）への判断。1つの質問に1件。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "decision", "category", "answer", "evidence", "forwardReason"],
        "properties": {
          "index": {
            "type": "integer"
          },
          "decision": {
            "description": "answer: 代理で答える。forward: 利用者に回す。",
            "type": "string",
            "enum": ["answer", "forward"]
          },
          "category": {
            "type": "string",
            "enum": [
              "fact",
              "issueState",
              "pastDecision",
              "convention",
              "policy",
              "priority",
              "money",
              "permission",
              "credential",
              "consent",
              "approval",
              "irreversible",
              "preference",
              "undetermined",
              "quality"
            ]
          },
          "answer": {
            "type": "string"
          },
          "evidence": {
            "description": "根拠。document（資料のパスと箇所）・decision（過去の決定のID）・reference（共通番号の解決結果）・recommendation（受付AIの推奨）。",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source", "location", "detail"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["document", "decision", "reference", "recommendation"]
                },
                "source": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          },
          "forwardReason": {
            "type": "string"
          }
        }
      }
    }
  }
}
