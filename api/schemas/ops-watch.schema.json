      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "item", "reason", "text", "evidence", "resolved", "requiresUser"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["retry", "reply", "repair", "notify", "none"]
          },
          "item": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "description": "job_recoveryのreplyはkind(fact|convention|pastDecision),sources(source:body|comment,index?,quote),approvalId?,conditions?を持つJSON文字列。repairはkind,cause,source,quote,scopeの原因証拠JSON。有事incidentは従来の根拠文字列。"
          },
          "resolved": {
            "type": "boolean"
          },
          "requiresUser": {
            "type": "boolean"
          }
        }
      }
    }
  }
