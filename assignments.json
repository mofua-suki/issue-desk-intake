    "preferenceSeconds": 30,
    "conflictRestartLines": 400,
    "scopeExemptPaths": [
      "README.md",
      "AGENTS.md"
    ]
  },
  "pollSeconds": 60,
  "antigravityRouting": {
    "maxFiles": 3,
    "repositories": [
      "*"
