    "lines": 400,
    "files": 8,
    "scopePaths": 12,
    "acceptance": 10,
    "riskLines": 500,
    "riskFiles": 16
  },
  "reviewNotes": {
    "minOccurrences": 2,
    "staleDays": 60,
    "maxBytes": 4000
